# Service « web » : fichiers statiques derrière le Caddy principal (qui gère HTTPS et /api).
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Fichiers versionnés par Vite : cache long. index.html : toujours revalidé.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html not path /assets/*
	header @html Cache-Control "no-cache"

	# Application monopage : toute route inconnue renvoie index.html (/p/…, /sources).
	try_files {path} /index.html
	file_server
}
