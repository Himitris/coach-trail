{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coach.himitris.fr/docs/plan-schema.json",
  "title": "Plan d'entraînement Coach Trail",
  "description": "Plan de séances (descriptions uniquement, rien n'est envoyé à la montre). Import : POST /api/plan/import. Version 2 : ajoute le bloc « plan » (nom, course).",
  "type": "object",
  "required": [
    "sessions"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Version du schéma ; 1 si absente. « plan » exige la version 2.",
      "enum": [
        1,
        2
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "description": "Nom du plan et course visée (version 2). Réimporter un plan du même nom le met à jour.",
      "properties": {
        "nom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Nom du plan, ex. « Prépa 3 Rocs – fin »."
        },
        "course": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Nom de la course visée (ou sa date AAAA-MM-JJ) ; sans effet si elle n'est pas reconnue."
        }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "items": {
        "$ref": "#/$defs/session"
      }
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "required": [
        "date",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Jour de la séance, AAAA-MM-JJ."
        },
        "type": {
          "enum": [
            "footing",
            "cotes",
            "seuil",
            "longue",
            "fractionne",
            "course",
            "renfo",
            "repos",
            "autre"
          ],
          "description": "Nature de la séance (footing, côtes, seuil, sortie longue, fractionné, course, renforcement, repos, autre)."
        },
        "titre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Titre court ; par défaut le nom du type."
        },
        "duree_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "description": "Durée visée, en minutes."
        },
        "zone_cible": {
          "type": "string",
          "pattern": "^[1-5](-[1-5])?$",
          "description": "Zone de FC Garmin visée : « 2 » ou une fourchette croissante « 1-2 »."
        },
        "dplus_cible": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Dénivelé positif visé, en mètres."
        },
        "objectif": {
          "type": "string",
          "maxLength": 500,
          "description": "But de la séance (une phrase)."
        },
        "consignes": {
          "type": "string",
          "maxLength": 2000,
          "description": "Consignes d'exécution."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "plan"
        ]
      },
      "then": {
        "properties": {
          "version": {
            "const": 2
          }
        },
        "required": [
          "version"
        ]
      }
    }
  ]
}
