# Copier en .env (jamais commité)
TZ=Europe/Paris
DOMAIN=coach.himitris.fr
TAILSCALE_IP=100.x.y.z
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
ACME_EMAIL=
INTERVALS_ATHLETE_ID=
INTERVALS_API_KEY=
GARMIN_TOKEN_DIR=/data/garmin_tokens
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
DATABASE_PATH=/data/coach.db
# Sauvegardes : BACKUP_HOST_DIR = dossier de l'hôte sur un disque distinct (monté en /backup).
BACKUP_HOST_DIR=/mnt/backup/coach-trail
BACKUP_TIME=04:30
# Serveur MCP (lecture seule) : jeton partagé facultatif (vide = pas de verrouillage ; réseau Tailscale seulement).
MCP_TOKEN=
